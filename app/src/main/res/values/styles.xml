<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Widget.IDoctor.Tarjeta" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">@color/white</item>
        <item name="cardCornerRadius">24dp</item>
        <item name="cardElevation">7dp</item>
        <item name="strokeColor">@color/azul_claro</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="Widget.IDoctor.Boton" parent="Widget.Material3.Button">
        <item name="android:minHeight">56dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textStyle">bold</item>
        <item name="backgroundTint">@color/azul_principal</item>
        <item name="cornerRadius">14dp</item>
    </style>

    <style name="Widget.IDoctor.BotonSecundario" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">56dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/azul_principal</item>
        <item name="strokeColor">@color/azul_principal</item>
        <item name="strokeWidth">2dp</item>
        <item name="cornerRadius">14dp</item>
    </style>

    <style name="Widget.IDoctor.CampoTexto" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundColor">@color/fondo_campo</item>
        <item name="boxStrokeColor">@color/azul_principal</item>
        <item name="hintTextColor">@color/azul_principal</item>
        <item name="boxCornerRadiusTopStart">14dp</item>
        <item name="boxCornerRadiusTopEnd">14dp</item>
        <item name="boxCornerRadiusBottomStart">14dp</item>
        <item name="boxCornerRadiusBottomEnd">14dp</item>
    </style>

    <style name="Widget.IDoctor.Radio" parent="Widget.Material3.CompoundButton.RadioButton">
        <item name="buttonTint">@color/azul_principal</item>
        <item name="android:textColor">@color/texto_principal</item>
    </style>

    <style name="Text" />

    <style name="Text.IDoctor" />

    <style name="Text.IDoctor.Titulo">
        <item name="android:textColor">@color/azul_principal</item>
        <item name="android:textSize">26sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Text.IDoctor.Subtitulo">
        <item name="android:textColor">@color/azul_oscuro</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
    </style>

</resources>
