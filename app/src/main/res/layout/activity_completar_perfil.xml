<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#EAF6FF"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:gravity="center"
            android:text="Completar perfil"
            android:textColor="#1976D2"
            android:textSize="34sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="Añade tus datos para usar iDoctor"
            android:textColor="#607D8B"
            android:textSize="16sp" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="34dp"
            android:layout_marginBottom="24dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="24dp"
            app:cardElevation="7dp"
            app:strokeColor="#D4E9FA"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="22dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="Datos del usuario"
                    android:textColor="#0D47A1"
                    android:textSize="23sp"
                    android:textStyle="bold" />

                <RadioGroup
                    android:id="@+id/rgRol"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:orientation="vertical">

                    <com.google.android.material.radiobutton.MaterialRadioButton
                        android:id="@+id/rbPaciente"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Paciente"
                        android:textColor="#263238"
                        android:textSize="16sp"
                        app:buttonTint="#1976D2" />

                    <com.google.android.material.radiobutton.MaterialRadioButton
                        android:id="@+id/rbProfesional"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Profesional"
                        android:textColor="#263238"
                        android:textSize="16sp"
                        app:buttonTint="#1976D2" />

                </RadioGroup>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:hint="Nombre"
                    app:boxBackgroundColor="#F7FBFF"
                    app:boxBackgroundMode="outline"
                    app:boxCornerRadiusBottomEnd="14dp"
                    app:boxCornerRadiusBottomStart="14dp"
                    app:boxCornerRadiusTopEnd="14dp"
                    app:boxCornerRadiusTopStart="14dp"
                    app:boxStrokeColor="#1976D2"
                    app:hintTextColor="#1976D2"
                    app:startIconDrawable="@android:drawable/ic_menu_myplaces"
                    app:startIconTint="#1976D2">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edtNombre"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textPersonName"
                        android:textColor="#263238"
                        android:textColorHint="#90A4AE" />

                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:hint="Apellidos"
                    app:boxBackgroundColor="#F7FBFF"
                    app:boxBackgroundMode="outline"
                    app:boxCornerRadiusBottomEnd="14dp"
                    app:boxCornerRadiusBottomStart="14dp"
                    app:boxCornerRadiusTopEnd="14dp"
                    app:boxCornerRadiusTopStart="14dp"
                    app:boxStrokeColor="#1976D2"
                    app:hintTextColor="#1976D2"
                    app:startIconDrawable="@android:drawable/ic_menu_myplaces"
                    app:startIconTint="#1976D2">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edtApellidos"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textPersonName"
                        android:textColor="#263238"
                        android:textColorHint="#90A4AE" />

                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:hint="Teléfono"
                    app:boxBackgroundColor="#F7FBFF"
                    app:boxBackgroundMode="outline"
                    app:boxCornerRadiusBottomEnd="14dp"
                    app:boxCornerRadiusBottomStart="14dp"
                    app:boxCornerRadiusTopEnd="14dp"
                    app:boxCornerRadiusTopStart="14dp"
                    app:boxStrokeColor="#1976D2"
                    app:hintTextColor="#1976D2"
                    app:startIconDrawable="@android:drawable/ic_menu_call"
                    app:startIconTint="#1976D2">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edtTelefono"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="phone"
                        android:textColor="#263238"
                        android:textColorHint="#90A4AE" />

                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:hint="Foto opcional"
                    app:boxBackgroundColor="#F7FBFF"
                    app:boxBackgroundMode="outline"
                    app:boxCornerRadiusBottomEnd="14dp"
                    app:boxCornerRadiusBottomStart="14dp"
                    app:boxCornerRadiusTopEnd="14dp"
                    app:boxCornerRadiusTopStart="14dp"
                    app:boxStrokeColor="#1976D2"
                    app:hintTextColor="#1976D2"
                    app:startIconDrawable="@android:drawable/ic_menu_camera"
                    app:startIconTint="#1976D2">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edtFoto"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textUri"
                        android:textColor="#263238"
                        android:textColorHint="#90A4AE" />

                </com.google.android.material.textfield.TextInputLayout>

                <LinearLayout
                    android:id="@+id/layoutPaciente"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="22dp"
                        android:text="Datos de paciente"
                        android:textColor="#0D47A1"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:hint="DNI"
                        app:boxBackgroundColor="#F7FBFF"
                        app:boxBackgroundMode="outline"
                        app:boxCornerRadiusBottomEnd="14dp"
                        app:boxCornerRadiusBottomStart="14dp"
                        app:boxCornerRadiusTopEnd="14dp"
                        app:boxCornerRadiusTopStart="14dp"
                        app:boxStrokeColor="#1976D2"
                        app:hintTextColor="#1976D2"
                        app:startIconDrawable="@android:drawable/ic_menu_info_details"
                        app:startIconTint="#1976D2">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/edtDni"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="text"
                            android:textColor="#263238"
                            android:textColorHint="#90A4AE" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:hint="Número de tarjeta sanitaria"
                        app:boxBackgroundColor="#F7FBFF"
                        app:boxBackgroundMode="outline"
                        app:boxCornerRadiusBottomEnd="14dp"
                        app:boxCornerRadiusBottomStart="14dp"
                        app:boxCornerRadiusTopEnd="14dp"
                        app:boxCornerRadiusTopStart="14dp"
                        app:boxStrokeColor="#1976D2"
                        app:hintTextColor="#1976D2"
                        app:startIconDrawable="@android:drawable/ic_menu_agenda"
                        app:startIconTint="#1976D2">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/edtNumeroTarjetaSanitaria"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="text"
                            android:textColor="#263238"
                            android:textColorHint="#90A4AE" />

                    </com.google.android.material.textfield.TextInputLayout>

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/layoutProfesional"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="22dp"
                        android:text="Datos profesionales"
                        android:textColor="#0D47A1"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:hint="Número de colegiado"
                        app:boxBackgroundColor="#F7FBFF"
                        app:boxBackgroundMode="outline"
                        app:boxCornerRadiusBottomEnd="14dp"
                        app:boxCornerRadiusBottomStart="14dp"
                        app:boxCornerRadiusTopEnd="14dp"
                        app:boxCornerRadiusTopStart="14dp"
                        app:boxStrokeColor="#1976D2"
                        app:hintTextColor="#1976D2"
                        app:startIconDrawable="@android:drawable/ic_menu_info_details"
                        app:startIconTint="#1976D2">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/edtNumeroColegiado"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="text"
                            android:textColor="#263238"
                            android:textColorHint="#90A4AE" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:hint="Especialidad"
                        app:boxBackgroundColor="#F7FBFF"
                        app:boxBackgroundMode="outline"
                        app:boxCornerRadiusBottomEnd="14dp"
                        app:boxCornerRadiusBottomStart="14dp"
                        app:boxCornerRadiusTopEnd="14dp"
                        app:boxCornerRadiusTopStart="14dp"
                        app:boxStrokeColor="#1976D2"
                        app:hintTextColor="#1976D2"
                        app:startIconDrawable="@android:drawable/ic_menu_manage"
                        app:startIconTint="#1976D2">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/edtEspecialidad"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="text"
                            android:textColor="#263238"
                            android:textColorHint="#90A4AE" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:hint="Descripción"
                        app:boxBackgroundColor="#F7FBFF"
                        app:boxBackgroundMode="outline"
                        app:boxCornerRadiusBottomEnd="14dp"
                        app:boxCornerRadiusBottomStart="14dp"
                        app:boxCornerRadiusTopEnd="14dp"
                        app:boxCornerRadiusTopStart="14dp"
                        app:boxStrokeColor="#1976D2"
                        app:hintTextColor="#1976D2"
                        app:startIconDrawable="@android:drawable/ic_menu_edit"
                        app:startIconTint="#1976D2">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/edtDescripcion"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="top"
                            android:inputType="textMultiLine"
                            android:minLines="3"
                            android:textColor="#263238"
                            android:textColorHint="#90A4AE" />

                    </com.google.android.material.textfield.TextInputLayout>

                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnGuardarPerfil"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="28dp"
                    android:text="Guardar perfil"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:backgroundTint="#1976D2"
                    app:cornerRadius="14dp"
                    app:iconGravity="textStart"
                    app:iconPadding="10dp"
                    app:iconTint="#FFFFFF" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCerrarSesion"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="14dp"
                    android:text="Cerrar sesión"
                    android:textAllCaps="false"
                    android:textColor="#1976D2"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:backgroundTint="#FFFFFF"
                    app:cornerRadius="14dp"
                    app:strokeColor="#1976D2"
                    app:strokeWidth="2dp"
                    app:iconGravity="textStart"
                    app:iconPadding="10dp"
                    app:iconTint="#1976D2" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

</ScrollView>